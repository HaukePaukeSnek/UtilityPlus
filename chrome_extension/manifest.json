{
  "manifest_version": 3,
  "name": "CS2 Nade Scraper - csnades.gg",
  "version": "1.1.0",
  "description": "Lade CS2 Granaten-Lineups (Videos, Bilder, Wurftechnik & Infos) direkt von csnades.gg in einen gewünschten Ordner herunter.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CS2 Nade Scraper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://csnades.gg/*",
    "*://*.csnades.gg/*",
    "*://assets.csnades.gg/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://csnades.gg/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}

